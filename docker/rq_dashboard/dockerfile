# Дашборд очередей Redis (:9181) — свой образ, а не общий с приложением.
#
# Раньше собирался из `docker/uvicorn/dockerfile` и весил 15.4 ГБ: тянул Playwright,
# Whisper, sentence-transformers и скачанные модели. Дашборду не нужно ничего из этого
# и даже сам код проекта — он читает служебные ключи очередей из Redis и рисует их
# веб-страницей.
#
# Пакет ставится в образ, а не командой при старте. Раньше в `docker-compose.yml` стояло
# `sh -c "pip install rq-dashboard && rq-dashboard ..."`: каждый перезапуск контейнера
# ходил в сеть за пакетом, и при недоступном PyPI дашборд не поднимался вовсе.
#
# Версия закреплена той, что уже работает на проде. Дашборд читает внутренние ключи rq,
# и их формат между версиями меняется — обновлять его стоит вместе с `rq`
# в `docker/uvicorn/requirements.txt`, а не самим по себе.
FROM python:3.11-slim

RUN pip install --no-cache-dir rq-dashboard==0.9.0

EXPOSE 9181

# Адрес Redis — по имени сервиса внутри сети compose. Переопределяется `command:`
# в `docker-compose.yml`, если понадобится другой.
CMD ["rq-dashboard", "--redis-url", "redis://redis:6379"]
