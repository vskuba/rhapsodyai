# Используем Python 3.12 (как в ваших логах)
FROM python:3.12-slim

# Устанавливаем системные зависимости для ffmpeg (нужен для Faster-Whisper и работы с голосом)
RUN apt-get update && apt-get install -y \
    ffmpeg \
    build-essential \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Устанавливаем временную зону системы внутри контейнера
RUN ln -sf /usr/share/zoneinfo/Etc/UTC /etc/localtime

# Создаем рабочую директорию
WORKDIR /app

# === Установка PyTorch CPU-only ПЕРЕД остальными зависимостями ===
# Это важно: torch должен установиться с CPU-индекса, иначе pip возьмёт CUDA-версию из PyPI
RUN pip install --no-cache-dir \
    torch \
    torchvision \
    torchaudio \
    --index-url https://download.pytorch.org/whl/cpu

# Копируем и устанавливаем остальные зависимости
COPY docker/telegram_soko/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

RUN python3 -c "from faster_whisper import download_model; download_model('base')"

# Копируем весь проект в контейнер
COPY . .

# Создаем папки для данных, если их нет (чтобы не было ошибок доступа)
RUN mkdir -p data/qdrant_storage data/history data/log data/report data/sqlite3

# Добавляем права на запись (777 гарантирует доступ любому пользователю внутри контейнера)
RUN chmod -R 777 data/qdrant_storage data/history data/log data/report data/sqlite3

# Указываем переменную окружения, чтобы Python не буферизировал логи
ENV PYTHONUNBUFFERED=1
ENV HF_HUB_OFFLINE=1

# Команда запуска (соответствует вашему main.py)
CMD ["python", "main_telegram_soko.py"]