# Используем Python 3.12 (как в ваших логах)
FROM python:3.12-slim

# Устанавливаем системные зависимости для ffmpeg (нужен для Faster-Whisper и работы с голосом)
RUN apt-get update && apt-get install -y \
    ffmpeg \
    build-essential \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Устанавливаем временную зону системы внутри контейнера
RUN ln -sf /usr/share/zoneinfo/Etc/UTC /etc/localtime

# Создаем рабочую директорию
WORKDIR /app

# === Установка PyTorch CPU-only ПЕРЕД остальными зависимостями ===
# Это важно: torch должен установиться с CPU-индекса, иначе pip возьмёт CUDA-версию из PyPI
#
# Только `torch`, без `torchvision` и `torchaudio`: их не импортирует ни строчка кода и
# не просит ни один пакет из requirements. Торч нужен `sentence-transformers`, а
# `faster-whisper` работает поверх CTranslate2 и торча не требует вовсе.
#
# Проверено на образе `uvicorn`, где тот же набор библиотек стоит без этих двух: модель
# `all-MiniLM-L6-v2` грузится и считает вектор, `faster_whisper` импортируется, и ни
# `torchvision`, ни `torchaudio` при этом в `sys.modules` не появляются.
RUN pip install --no-cache-dir \
    torch \
    --index-url https://download.pytorch.org/whl/cpu

# Копируем и устанавливаем остальные зависимости
COPY docker/telegram/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

RUN python3 -c "from faster_whisper import download_model; download_model('small')"
RUN python3 -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('all-MiniLM-L6-v2')"

# Копируем весь проект в контейнер
COPY . /app

# Создаем папки для данных, если их нет (чтобы не было ошибок доступа)
RUN mkdir -p data/qdrant_storage data/history data/log data/report data/sqlite3

# Добавляем права на запись (777 гарантирует доступ любому пользователю внутри контейнера)
RUN chmod -R 777 data/qdrant_storage data/history data/log data/report data/sqlite3 docker/logstash

# Указываем переменную окружения, чтобы Python не буферизировал логи
ENV PYTHONUNBUFFERED=1
ENV HF_HUB_OFFLINE=1
# py_modules — отдельный корень импортов (как в uvicorn-образе)
ENV PYTHONPATH="/app:/app/py_modules"

# Команда запуска (соответствует вашему main.py)
CMD ["python", "main_telegram.py"]