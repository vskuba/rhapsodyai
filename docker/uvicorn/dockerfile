# Используем легкий образ Python
FROM python:3.11-slim

# Устанавливаем временную зону системы внутри контейнера
RUN ln -sf /usr/share/zoneinfo/Etc/UTC /etc/localtime

RUN apt-get update && apt-get install -y \
    git \
    gcc \
    python3-dev \
    fonts-dejavu-core \
    default-mysql-client \
    && rm -rf /var/lib/apt/lists/*

# Устанавливаем рабочую директорию
WORKDIR /app

# Устанавливаем САМЫЕ тяжелые пакеты отдельно с увеличенным таймаутом
# Faster-whisper и Sentence-transformers тянут за собой много зависимостей
#
# Торч ставится ПЕРВЫМ и с CPU-индекса, отдельной командой. Порядок и отдельность
# обязательны: `--index-url` делает индекс основным, и faster-whisper с
# sentence-transformers оттуда не поставились бы — их нужно тянуть с обычного PyPI
# следующим шагом. Через `--extra-index-url` это не решается: PyPI остаётся основным,
# и pip берёт оттуда CUDA-сборку торча.
#
# CPU-сборка, а не CUDA. Раньше здесь стоял индекс `cu121` и явные `nvidia-cublas-cu12`
# с `nvidia-cudnn-cu12` — они тянули 4.5 ГБ CUDA-библиотек в образ, который никогда не
# видел видеокарты: ни прод (Oracle A1, aarch64), ни машина разработчика. Вдобавок
# фактически вставал не cu121, а cu130, и его собственные зависимости приносили ВТОРОЙ
# комплект тех же библиотек — `nvidia-cublas`, `nvidia-cudnn` и `nvidia-cuda-nvrtc`
# стояли в образе дважды, в версиях cu12 и cu13.
#
# Проверено сборкой пробного образа с этим же набором пакетов:
#   * распознавание речи не задето вовсе — `faster-whisper` считает на CTranslate2, а тот
#     с CUDA не слинкован (`ldd` по `_ext*.so` не даёт ни одной CUDA-зависимости) и
#     подгружает её динамически только при `device="cuda"`. У нас в коде жёстко
#     `device="cpu", compute_type="int8"` (`src/faster_whisper/faster_whisper_model.py`);
#   * один и тот же файл распознан одинаково: язык `en`, длительность 3.0, тот же текст;
#   * `sentence-transformers` даёт побитово тот же вектор `all-MiniLM-L6-v2`;
#   * site-packages: 7.9 ГБ → 1.7 ГБ.
#
# Колесо `torch-2.13.0+cpu-cp311-cp311-manylinux_2_28_aarch64.whl` на CPU-индексе есть —
# прод на ARM соберётся тем же путём, что и amd64.
RUN pip install --no-cache-dir --default-timeout=1000 \
    torch --index-url https://download.pytorch.org/whl/cpu

RUN pip install --no-cache-dir --default-timeout=1000 \
    faster-whisper \
    sentence-transformers

# Копируем файл с зависимостями
COPY docker/uvicorn/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Устанавливаем Playwright Chromium (headless-shell для headless-режима) + системные зависимости
RUN playwright install chromium-headless-shell --with-deps

ENV HF_HOME=/root/.cache/huggingface
ENV FASTEMBED_CACHE_PATH=/root/.cache/fastembed

RUN python3 -c "from faster_whisper import download_model; download_model('base'); download_model('small')"
RUN python3 -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('all-MiniLM-L6-v2')"

RUN python3 -c "from fastembed import TextEmbedding, SparseTextEmbedding; TextEmbedding(model_name='sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2'); SparseTextEmbedding(model_name='Qdrant/bm25')"

RUN pip install rq rq-dashboard redis

# Модели уже скачаны выше в слои образа — в рантайме работаем только с локальным кэшем,
# без HEAD-проверок huggingface.co (иначе его недоступность блокирует старт сервера)
ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1

# Копируем весь код проекта в контейнер
COPY . /app

ENV PYTHONPATH="/app:/app/py_modules"

# Создаем папки для данных, если их нет (чтобы не было ошибок доступа)
RUN mkdir -p data/qdrant_storage data/history data/log data/report data/sqlite3

# Добавляем права на запись (777 гарантирует доступ любому пользователю внутри контейнера)
RUN chmod -R 777 data/qdrant_storage data/history data/log data/report data/sqlite3 docker/logstash

# SSH-клиент для вкладки GX10 (управление сервисами локальных LLM по SSH).
# Слой добавлен В КОНЦЕ файла: пересборка не трогает кэшированные слои с торчем
# и моделями (15 ГБ), а добавляет ~5 МБ. sshpass берёт пароль из SSHPASS,
# пароль в argv не попадает (правило про секреты).
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssh-client \
    sshpass \
    && rm -rf /var/lib/apt/lists/*

# Запускаем Uvicorn
# --host 0.0.0.0 обязателен, чтобы контейнер был доступен снаружи
CMD ["uvicorn", "main_uvicorn:app", "--host", "0.0.0.0", "--port", "8000"]