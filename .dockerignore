# Что НЕ уходит в контекст сборки.
#
# Контекст здесь — весь репозиторий, и на проде он весил 1.1 ГБ, из которых 987 МБ
# занимал `data/cronicle` и 71 МБ — `data/log`. Каждая сборка на сервере (их три:
# uvicorn через bluegreen, воркеры, браузер) заново паковала и отправляла демону этот
# гигабайт, а `COPY . /app` давал слой, который менялся при каждом деплое — потому что
# логи и данные Cronicle пишутся постоянно. Следом шли `RUN mkdir` и `RUN chmod -R 777`
# поверх того же гигабайта, и кеш слоёв не срабатывал даже между тремя сборками одного
# деплоя.
#
# Ничего из исключённого в образе не нужно: все сервисы монтируют репозиторий в `/app`
# при запуске (`./:/app` в docker-compose.yml), то есть содержимое `COPY . /app`
# перекрывается монтированием ещё до старта приложения.

# --- Рабочие данные: пишутся в рантайме, приезжают монтированием ---
data/cronicle/
data/log/
data/backups/
data/seeds/
data/report/
data/planning/
data/qdrant_storage/
data/history/
data/sqlite3/

# --- Рабочие каталоги задач: каждый — полная выкладка репозитория ---
.claude/worktrees/

# --- Секреты: в образ не попадают ни при каких условиях ---
#
# `.ssh/` держит приватный ключ от прод-сервера. В git его нет (`.gitignore`), поэтому
# в образ, который собирает GitHub Actions, он не попадал никогда — там свежий чекаут.
# А вот локальные сборки (`docker compose build`) брали его из рабочей копии и клали
# в слой `COPY . /app`: ключ от прода жил внутри образов на машине разработчика.
#
# `.env*` целиком, а не один `.env`: рядом лежат `.env.local` с паролями тестовых
# учёток и `.env.prod`. Приложению они в образе не нужны — переменные приезжают из
# compose, а сами файлы из монтирования репозитория.
.ssh/
.env*

# --- Логи и индексы оболочки: десятки мегабайт, приложению не нужны ---
.claude-shell/
.memsearch/

# --- Стандартные исключения ---
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.venv/
venv/
.git/
.idea/
*.db
*.sqlite3
*.log
