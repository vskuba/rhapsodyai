APP_ENV=

LLM='ollama/qwen2.5:14b'

# ai providers
OPENROUTER_API_URL=https://openrouter.ai
OPENROUTER_API_KEY=

CLAUDE_API_URL=https://api.anthropic.com
CLAUDE_API_KEY=

OLLAMA_API_URL=http://host.docker.internal:11434/v1
OLLAMA_API_KEY=ollama

GEMINI_API_URL=https://generativelanguage.googleapis.com
GEMINI_API_KEY=

MISTRAL_API_URL=https://api.mistral.ai/v1
MISTRAL_API_KEY=

HUGGINGFACE_API_URL=https://router.huggingface.co/v1
HUGGINGFACE_API_KEY=

GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=

CEREBRAS_API_URL=https://api.cerebras.ai/v1
CEREBRAS_API_KEY=

# github
GITHUB_TOKEN=

# faster-wisper
WHISPER_MODEL_NAME=base
WHISPER_LANGUAGE=ru

# project folders
DATA_DIR=data
LOG_DIR=log
MCP_DIR=mcp
UVICORN_DIR=uvicorn

# ollama settings
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDINGS_OLLAMA_MODEL_NAME=nomic-embed-text
LITELLM_LOG=ERROR

# ai tools
SERPER_API_KEY=

# JIRA credentials MCP server
JIRA_URL=
JIRA_API_TOKEN=
JIRA_EMAIL=
JIRA_CLOUD_ID=

# other
OTEL_SDK_DISABLED=true
ANONYMIZED_TELEMETRY=False
CREWAI_TELEMETRY_OPT_OUT=true
SESSION_SECRET_KEY=

# telegram
TELEGRAM_TOKEN_SOKO=
TELEGRAM_TOKEN_RHAPSODY=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_MINI_APP_URL=

# redis
REDIS_URL=redis://redis:6379

# mysql
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=developer
MYSQL_PASSWORD=password
MYSQL_DATABASE=project

# ⚠ Счёт запросов к базе (подвкладка «MySQL» на /admin/journal) выключателя здесь
# НЕ имеет — он настройкой `journal_mysql_enabled` на /admin/setting. Переменной
# окружения он был ровно один коммит: на проде её пришлось бы класть через secret
# `ENV_FILE`, а погасить счёт — правкой конфига с перезапуском контейнеров.

# Порты админ-инструментов для ссылок в шапке админки (`base.html`). В коде номеров нет,
# всё отсюда. На сервис один ключ `<NAME>_PORT` и одна ссылка: она открывается в браузере
# админа и ведёт на его `localhost` — до прод-сервисов он ходит через SSH-туннель
# (`LocalForward` в `~/.ssh/config`), до локальных напрямую. Здесь лежат порты этой
# инсталляции; машина разработчика переопределяет их в своём `.env.local`, потому что
# туннель занимает порт первым и локальные контейнеры уведены на соседние
# (`docker-compose.override.yml`).
PHPMYADMIN_PORT=9634
CRONICLE_PORT=3012
QDRANT_PORT=6333
OPENSEARCH_DASHBOARDS_PORT=5601
RQ_DASHBOARD_PORT=9181
GATUS_PORT=8090

# Grafana стоит вне docker-compose, на отдельной машине — поэтому адрес целиком.
GRAFANA_URL=http://192.168.1.2:3000/d/ad2w6ww/gx10?orgId=1&from=now-30m&to=now&timezone=browser&refresh=5s

# Хостовой путь этого чекаута. Читает только docker-compose: репозиторий
# монтируется вторым разом по тому же пути, что и на хосте, — иначе рабочие
# каталоги задач (`.claude/worktrees`, см. `src/project/task/task_worktree.py`)
# создаются с путями `/app/...` и на хосте не открываются.
#
# Это каталог проекта самой установки. Карточки заводят и на другие проекты
# машины (`project.work_dir`), у каждого свой репозиторий; их каталоги
# монтируются отдельно — в `docker-compose.override.yml`, тем же правилом
# «путь внутри = путь снаружи». См. `.claude/docs/project_task.md`.
PROJECT_HOST_DIR=/srv/rhapsodyai

# Сервер задачи для проекта самой установки: над рабочим каталогом подзадачи его
# поднимает ./task_server.sh (сервис `uvicorn_task`), на этот адрес ходит QA.
# У других проектов машины свой сервер и свой порт — их адрес хранится в карточке
# проекта (`project.task_server_url`), а это значение остаётся запасным.
PROJECT_TASK_QA_SERVER_URL=http://localhost:8013

# ─── Контейнер-браузер (`browser`, см. .claude/docs/browser.md) ────────────────

# Предел живых страниц. Ограничение не Chromium-а, а `mem_limit: 4g` контейнера:
# страница обычного сайта стоит ~83 МБ, долгоживущая SPA дороже. 25 — половина
# расчётного максимума, запас на разрастание. Замер — в `GET /browser/session`.
BROWSER_SESSION_LIMIT=25

# Токен для `X-Browser-Token`. Пусто — проверки нет, и это норма: порт сервиса
# опубликован на 127.0.0.1, а с бэкендом он говорит по внутренней сети.
# Заполнять, если сервис окажется доступен шире.
BROWSER_API_TOKEN=

# Адрес контейнера во внутренней сети — по нему `uvicorn` проксирует админку
# (`/api/browser/*`). Имя сервиса из compose, а не `localhost:8014`: петлевой порт
# виден только с хоста, из соседнего контейнера туда хода нет.
BROWSER_URL=http://browser:8000

# Адрес DeepSeek-харнесса для иконки 🐋 в меню Telegram Mini App. Уходит на фронтенд
# через `/setting/config`, читается в `sidebar.js`. Пусто — кнопка скажет, что адрес
# не задан, и никуда не поведёт: подставлять сюда догадку нельзя, сервис внешний.
DEEPSEEK_HARNESS_GX10=

# Машина GX10 с локальными LLM (llama.cpp) и ComfyUI: вкладка LLM → GX10.
# uvicorn ходит на неё по SSH (sshpass). Пусто — вкладка покажет «не настроен»
# и никуда ходить не будет. Реальные значения — в `.env.local` этой машины.
GX10_HOST=
GX10_PORT=22
GX10_USERNAME=
GX10_PASSWORD=

# Ключ шифрования секретных переменных сайта (`browser_site_variable`).
# Значение — 32 байта в base64: `python3 -c "from cryptography.fernet import Fernet;
# print(Fernet.generate_key().decode())"`. Ключ у каждой установки свой и в
# репозиторий не попадает; на прод едет секретом CI, как остальное окружение.
# Пусто — секретные переменные заводить нельзя, страница скажет об этом прямо.
# Потеря ключа = потеря значений: расшифровать их нечем, заводятся заново.
BROWSER_SECRET_KEY=

# Пульты постоянно живущего `ds-shell --service` — ими страница команды включает и
# выключает роли DeepSeek Harness (кнопки на карточках). Сам хост Harness слушает
# только петлю ноутбука и наружу не поднимается, поэтому ходим через посредника.
#
# Список через запятую — по одному адресу на машину, а не на проект: пульт держит
# столько проектов, сколько ему подключили кнопкой в шапке блока. Чей пульт какой,
# страница не задаёт: каждый называет свои каталоги сам, по ним кнопки и раскладываются.
#
# Умолчание — мост docker: из контейнера петля хоста недостижима. Не отзывается —
# карточки останутся без кнопок, и страница скажет причину словами.
DSH_CONTROL_URL=http://host.docker.internal:8791

# Планировщик Cronicle: ключ API для страницы /admin/cronicle.
# Заводится в панели Cronicle (Admin -> API Keys), галочка нужна одна —
# «Edit Events» (только ради переключателя). Пустой ключ — страница скажет об
# этом и ничего не сломает.
#
# Адреса здесь нет намеренно: умолчание `http://cronicle:3012` верно для любой
# установки. Задавать CRONICLE_URL нужно только в необычной раскладке, и тогда
# порт берётся ВНУТРИСЕТЕВОЙ (3012), а не опубликованный наружу —
# docker-compose.override.yml маппит 3013:3012, и 3013 изнутри не отвечает.
CRONICLE_API_KEY=
